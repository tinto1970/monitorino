# Copia questo file in ".env" e riempi i valori reali. Non committare mai ".env".

# Indirizzo Gmail mittente
GMAIL_USER=tuonome@gmail.com

# App Password Gmail (16 caratteri, generata da:
# https://myaccount.google.com/apppasswords - richiede 2FA attiva sull'account)
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Indirizzo/i destinatario/i delle notifiche, separati da virgola
GMAIL_TO=tuonome@gmail.com

# Intervallo tra un giro di controlli e il successivo, in secondi
CHECK_INTERVAL_SECONDS=60

# Timeout in secondi per ping e connessione TCP
CHECK_TIMEOUT_SECONDS=3

# Numero di controlli falliti consecutivi prima di considerare un host "giù"
# (evita falsi allarmi per un singolo pacchetto perso)
FAILURE_THRESHOLD=3

# Ore del giorno (ora locale della board, 0-23, separate da virgola) in cui
# inviare un'email di riepilogo con lo stato di tutti gli host monitorati,
# indipendentemente da eventuali allarmi
SUMMARY_HOURS=8,20
