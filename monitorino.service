[Unit]
Description=Monitorino - monitoraggio server rete locale con alert Gmail
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=arduino
WorkingDirectory=/home/arduino/git/monitorino
ExecStart=/usr/bin/python3 /home/arduino/git/monitorino/monitor.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
